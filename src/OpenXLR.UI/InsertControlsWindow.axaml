<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OpenXLR.UI"
        x:Class="OpenXLR.UI.InsertControlsWindow"
        x:DataType="vm:InsertViewModel"
        Title="{Binding Label}" Width="820" Height="720" MinWidth="520" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="#16181d">

  <!-- same flat fader thumbs as the main window: the Fluent slider sizes
       its thumb from these theme resources -->
  <Window.Resources>
    <x:Double x:Key="SliderHorizontalThumbWidth">22</x:Double>
    <x:Double x:Key="SliderHorizontalThumbHeight">10</x:Double>
    <x:Double x:Key="SliderVerticalThumbWidth">10</x:Double>
    <x:Double x:Key="SliderVerticalThumbHeight">22</x:Double>
    <CornerRadius x:Key="SliderThumbCornerRadius">2</CornerRadius>
  </Window.Resources>

  <Window.Styles>
    <Style Selector="Slider /template/ Thumb">
      <Setter Property="CornerRadius" Value="2"/>
    </Style>
    <Style Selector="TextBlock.h">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#8b93a7"/>
    </Style>
    <Style Selector="TextBlock.val">
      <Setter Property="Foreground" Value="#e6e9f0"/>
      <Setter Property="FontFamily" Value="monospace"/>
    </Style>
    <Style Selector="Slider">
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="Height" Value="30"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
  </Window.Styles>

  <DockPanel Margin="16">
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
      <StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Ellipse Width="10" Height="10" VerticalAlignment="Center"
                   Fill="{Binding IsActive, Converter={x:Static vm:Converters.ActiveLed}}"/>
          <TextBlock Text="{Binding Label}" FontSize="16" FontWeight="Bold" Foreground="#e6e9f0"/>
          <TextBlock Text="{Binding StateText}" Classes="h" VerticalAlignment="Center"/>
        </StackPanel>
        <TextBlock Text="{Binding Plugin}" Classes="h" FontSize="11"/>
        <TextBlock Text="{Binding Error}" Foreground="#e0a05a" FontSize="11" IsVisible="{Binding HasError}"/>
        <TextBlock Text="{Binding NativeUiNote}" Foreground="#e0a05a" TextWrapping="Wrap"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Top">
        <Button Content="Native plugin UI…" Click="OnNativeUi" IsEnabled="{Binding CanOpenNativeUi}"
                ToolTip.Tip="Open the manufacturer's editor with its live meters and analysis"/>
        <Button Content="Defaults" Padding="12,4" Click="OnDefaults"
                ToolTip.Tip="Put every control back to the plugin's own defaults"/>
        <ToggleButton Content="Bypass" IsChecked="{Binding Bypass, Mode=TwoWay}" Padding="12,4"/>
      </StackPanel>
    </Grid>
    <Border DockPanel.Dock="Top" Background="#20232b" CornerRadius="6" Padding="10" Margin="0,0,0,10">
      <Grid ColumnDefinitions="*,Auto,8,*,Auto" RowDefinitions="Auto,Auto">
        <ComboBox ItemsSource="{Binding PluginPresetNames}" SelectedItem="{Binding SelectedPluginPreset}"
                  PlaceholderText="Plugin preset" MinWidth="170"/>
        <Button Grid.Column="1" Content="Load" Padding="10,3" IsEnabled="{Binding CanLoadPluginPreset}"
                Click="OnLoadPreset"/>
        <TextBox Grid.Column="3" Text="{Binding NewPluginPresetName}" PlaceholderText="New preset name"
                 MaxLength="80" MinWidth="160"/>
        <Button Grid.Column="4" Content="Save as" Padding="10,3" Margin="6,0,0,0" Click="OnSavePreset"/>
        <TextBlock Grid.Row="1" Grid.ColumnSpan="5" Text="{Binding PresetNote}" Foreground="#e0a05a"
                   FontSize="11" Margin="0,6,0,0"/>
      </Grid>
    </Border>
    <Button DockPanel.Dock="Bottom" Content="Close" HorizontalAlignment="Right" Padding="18,6" Margin="0,10,0,0" Click="OnClose"/>
    <!-- AllowAutoHide off: the scrollbar reserves its own column instead
         of floating over the value readouts -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" AllowAutoHide="False">
      <StackPanel Margin="0,0,10,0" Spacing="12">
        <Border IsVisible="{Binding HasSidechains}" Background="#20232b" CornerRadius="6" Padding="10">
          <StackPanel Spacing="6">
            <TextBlock Text="SIDECHAIN / AUX INPUTS" Classes="h"/>
            <ItemsControl ItemsSource="{Binding Sidechains}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:InsertSidechainViewModel">
                  <Grid ColumnDefinitions="*,12,220" Margin="0,3">
                    <TextBlock Text="{Binding Name}" Foreground="#e6e9f0" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="2" ItemsSource="{Binding Sources}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                              HorizontalAlignment="Stretch"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
        <StackPanel IsVisible="{Binding HasVisualization}" Spacing="5">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="BAND / THRESHOLD SETTINGS" Classes="h"/>
            <TextBlock Grid.Column="1" Text="parameter overview · not an audio spectrum" Foreground="#6b7285" FontSize="10"/>
          </Grid>
          <vm:PluginVisualizer Insert="{Binding}" Height="220"/>
          <TextBlock Text="Settings overview. Use Native plugin UI for the manufacturer's live EQ spectrum, compression meters and detailed controls."
                     TextWrapping="Wrap" Foreground="#8b93a7" FontSize="11"/>
        </StackPanel>
        <ItemsControl ItemsSource="{Binding Groups}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:InsertParamGroup">
              <StackPanel Margin="0,0,0,12">
                <Border IsVisible="{Binding ShowHeader}" BorderBrush="#2d313c" BorderThickness="0,0,0,1"
                        Margin="0,0,0,8" Padding="0,0,0,4">
                  <TextBlock Text="{Binding Name}" Foreground="#b9bfcc" FontSize="12" FontWeight="SemiBold"/>
                </Border>
                <ItemsControl ItemsSource="{Binding Params}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:InsertParamViewModel">
                      <Border Background="#20232b" BorderBrush="#2d313c" BorderThickness="1" CornerRadius="6"
                              Width="142" Height="132" Margin="0,0,8,8" Padding="8,6"
                              ToolTip.Tip="{Binding Symbol}">
                        <Grid RowDefinitions="32,*,24">
                          <TextBlock Text="{Binding Name}" Classes="h" FontSize="11" TextWrapping="Wrap"
                                     TextTrimming="CharacterEllipsis" TextAlignment="Center"/>
                          <vm:ArcKnob Grid.Row="1" Width="70" Height="70" HorizontalAlignment="Center"
                                      Minimum="{Binding Min}" Maximum="{Binding Max}"
                                      Value="{Binding Value, Mode=TwoWay}" Step="{Binding Step}"
                                      IsLogarithmic="{Binding Logarithmic}" IsVisible="{Binding IsKnob}"/>
                          <ToggleSwitch Grid.Row="1" IsChecked="{Binding On, Mode=TwoWay}"
                                        IsVisible="{Binding Toggled}" HorizontalAlignment="Center"
                                        VerticalAlignment="Center" OnContent="On" OffContent="Off"/>
                          <ComboBox Grid.Row="1" ItemsSource="{Binding ScalePoints}"
                                    SelectedItem="{Binding SelectedScalePoint, Mode=TwoWay}"
                                    IsVisible="{Binding Enumeration}" HorizontalAlignment="Stretch"
                                    VerticalAlignment="Center" FontSize="11"/>
                          <TextBlock Grid.Row="2" Text="{Binding ValueText}" Classes="val" FontSize="11"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>

<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="OpenXLR.UI.App"
             RequestedThemeVariant="Dark">
             <!-- Mixer surfaces use a fixed dark palette; matching control
                  templates keep text readable on light-themed desktops too. -->

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>
</Application>

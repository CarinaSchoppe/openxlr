<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:OpenXLR.UI.Localization" xmlns:vm="using:OpenXLR.UI"
        x:Class="OpenXLR.UI.WaveInterfacesWindow" x:DataType="vm:MainViewModel"
        Title="{loc:Text Key=WaveInterfaces}" Width="680" Height="620" MinWidth="480" MinHeight="360"
        Background="{DynamicResource Ox.Window.Background}">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="16" Spacing="12">
      <TextBlock Classes="hint" Text="{loc:Text Key=WaveInterfacesHint}" TextWrapping="Wrap"/>
      <ItemsControl ItemsSource="{Binding WaveInterfaces}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:WaveInterfaceViewModel">
            <Border Classes="card" Padding="12" Margin="0,0,0,10">
              <StackPanel Spacing="8">
                <TextBlock Classes="body" Text="{Binding Name}" TextWrapping="Wrap"/>
                <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}" IsEnabled="{Binding CanEnable}"><TextBlock Text="{loc:Text Key=EnableAdditionalInterface}" TextWrapping="Wrap"/></CheckBox>
                <StackPanel IsEnabled="{Binding CanControl}" Spacing="6">
                  <Grid ColumnDefinitions="*,64" IsVisible="{Binding HasGain}">
                    <Slider IsEnabled="{Binding CanAdjustGain}" Minimum="0" Maximum="75" Value="{Binding Gain, Mode=TwoWay}"/>
                    <TextBlock Classes="val" Grid.Column="1" Text="{Binding Gain, StringFormat='{}{0} dB'}"/>
                  </Grid>
                  <WrapPanel ItemSpacing="8" LineSpacing="4">
                    <ToggleButton Content="{loc:Text Key=Mute}" IsChecked="{Binding Mute, Mode=TwoWay}" IsVisible="{Binding HasMute}"/>
                    <ToggleButton Content="{loc:Text Key=LowCut}" IsChecked="{Binding LowCut, Mode=TwoWay}" IsVisible="{Binding HasLowCut}"/>
                    <ToggleButton Content="{loc:Text Key=ClipGuard}" IsChecked="{Binding ClipGuard, Mode=TwoWay}" IsVisible="{Binding HasClipGuard}"/>
                    <ToggleButton Content="48V" IsChecked="{Binding Phantom, Mode=TwoWay}" IsVisible="{Binding HasPhantom}"/>
                    <TextBlock Classes="hint" Text="{loc:Text Key=PhantomSettling}" IsVisible="{Binding PhantomSettling}"/>
                  </WrapPanel>
                  <StackPanel IsVisible="{Binding HasSecondInput}">
                    <Grid ColumnDefinitions="*,64">
                      <Slider IsEnabled="{Binding CanAdjustGain}" Minimum="0" Maximum="75" Value="{Binding Gain2, Mode=TwoWay}"/>
                      <TextBlock Classes="val" Grid.Column="1" Text="{Binding Gain2, StringFormat='{}{0} dB'}"/>
                    </Grid>
                    <WrapPanel ItemSpacing="8" LineSpacing="4">
                      <ToggleButton Content="{loc:Text Key=MuteInput2}" IsChecked="{Binding Mute2, Mode=TwoWay}"/>
                      <ToggleButton Content="48V" IsChecked="{Binding Phantom2, Mode=TwoWay}" IsVisible="{Binding HasPhantom}"/>
                      <ToggleButton Content="{loc:Text Key=LowCut}" IsChecked="{Binding LowCut2, Mode=TwoWay}" IsVisible="{Binding HasLowCut}"/>
                      <ToggleButton Content="{loc:Text Key=ClipGuard}" IsChecked="{Binding ClipGuard2, Mode=TwoWay}" IsVisible="{Binding HasClipGuard}"/>
                    </WrapPanel>
                  </StackPanel>
                  <TextBlock Classes="h" Text="{loc:Text Key=CaptureSource}"/>
                  <ComboBox AutomationProperties.Name="{loc:Text Key=CaptureSource}" ItemsSource="{Binding Sources}" SelectedItem="{Binding Source, Mode=TwoWay}" HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:AudioDeviceItem"><TextBlock Classes="body" Text="{Binding Label}" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate>
                  </ComboBox>
                  <TextBlock Classes="h" Text="{loc:Text Key=MicrophoneNumber}"/>
                  <NumericUpDown AutomationProperties.Name="{loc:Text Key=MicrophoneNumber}" Minimum="1" Maximum="{Binding MaximumInput}" Value="{Binding InputNumber, Mode=TwoWay}"/>
                  <TextBlock Classes="h" Text="{loc:Text Key=ChannelName}"/>
                  <TextBox Text="{Binding ChannelName, Mode=TwoWay}" MaxLength="60" AutomationProperties.Name="{loc:Text Key=ChannelName}"/>
                  <Button Content="{loc:Text Key=AddWaveInput}" Click="OnAddInput"/>
                </StackPanel>
                <TextBlock Text="{Binding Warning}" TextWrapping="Wrap" Foreground="{DynamicResource Ox.Text.Warning}"/>
                <TextBlock Text="{Binding Error}" TextWrapping="Wrap" Foreground="{DynamicResource Ox.Text.Warning}"/>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</Window>

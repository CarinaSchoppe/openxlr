<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OpenXLR.Tests" />
    <None Include="../../native/openxlr-lv2-host" Link="openxlr-lv2-host" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="$([MSBuild]::IsOSPlatform('Linux'))" />
  </ItemGroup>

  <Target Name="BuildNativeLv2Host" BeforeTargets="BeforeBuild" Condition="$([MSBuild]::IsOSPlatform('Linux'))">
    <Exec Command="make -C &quot;$(MSBuildProjectDirectory)/../../native&quot;" />
  </Target>

</Project>

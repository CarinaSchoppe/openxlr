#!/usr/bin/make -f
%:
	dh $@

override_dh_auto_configure:
	:

# Ubuntu ships the winelib compilers as winegcc-stable and wineg++-stable, and
# the build calls them by their plain names. Put the plain names on PATH for
# the build when the distribution does not provide them.
override_dh_auto_build:
	mkdir -p debian/winetools
	for tool in winegcc wineg++; do \
		command -v $$tool >/dev/null || ln -sf "$$(command -v $$tool-stable)" "debian/winetools/$$tool"; \
	done
	PATH="$(CURDIR)/debian/winetools:$$PATH" \
		python3 openxlr-packaging/build.py build --source . --output out

override_dh_auto_test:
	:

override_dh_auto_install:
	python3 openxlr-packaging/build.py stage --source . --output out --destdir debian/openxlr-yabridge
	python3 openxlr-packaging/test-package.py debian/openxlr-yabridge

override_dh_auto_clean:
	rm -rf out debian/winetools

override_dh_dwz:
	:

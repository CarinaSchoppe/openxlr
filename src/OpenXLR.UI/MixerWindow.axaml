<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:OpenXLR.UI.Localization"
        x:Class="OpenXLR.UI.MixerWindow"
        Title="{loc:Text Key=MixerWindowTitle}" Width="800" Height="480" MinWidth="320" MinHeight="240"
        Icon="avares://OpenXLR.UI/Assets/icon.png">
  <Window.Styles>
    <StyleInclude Source="avares://OpenXLR.UI/MixerStyles.axaml"/>
  </Window.Styles>
  <DockPanel Margin="8">
    <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,8">
      <Button Content="{loc:Text Key=DockMixer}" Click="OnDockMixer" HorizontalAlignment="Left"/>
      <!-- the panel's size in this window only; the main window keeps the skin's -->
      <WrapPanel>
        <TextBlock Text="{loc:Text Key=MixerScale}" Classes="body" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <ComboBox Name="MixerScalePicker" AutomationProperties.Name="{loc:Text Key=MixerScale}"
                  ToolTip.Tip="{loc:Text Key=MixerScaleHint}" Margin="0,0,8,0"/>
        <!-- shown for Custom: any whole percent in the range, held to it when typed past either end -->
        <StackPanel Name="MixerScaleCustomRow" Orientation="Horizontal" Spacing="4" IsVisible="False">
          <NumericUpDown Name="MixerScaleCustom" FormatString="0" ClipValueToMinMax="True" VerticalAlignment="Center"
                         VerticalContentAlignment="Center"
                         AutomationProperties.Name="{loc:Text Key=MixerScaleCustomName}"
                         ToolTip.Tip="{loc:Text Key=MixerScaleCustomHint}"/>
          <TextBlock Text="{loc:Text Key=MixerScaleCustomUnit}" Classes="body" VerticalAlignment="Center"/>
        </StackPanel>
      </WrapPanel>
      <TextBlock Name="MixerScaleNote" Classes="note" TextWrapping="Wrap" IsVisible="False"/>
    </StackPanel>
    <ScrollViewer Name="MixerScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
      <LayoutTransformControl Name="PanelScale"/>
    </ScrollViewer>
  </DockPanel>
</Window>

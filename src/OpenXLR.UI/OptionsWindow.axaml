<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OpenXLR.UI"
        x:Class="OpenXLR.UI.OptionsWindow"
        x:DataType="vm:OptionsViewModel"
        Title="OpenXLR Options" Width="580" Height="740" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="#16181d">

  <Window.Styles>
    <Style Selector="TextBlock.h">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#8b93a7"/>
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="#1d2027"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="14"/>
    </Style>
    <Style Selector="CheckBox">
      <Setter Property="Foreground" Value="#e6e9f0"/>
    </Style>
  </Window.Styles>

  <ScrollViewer>
  <StackPanel Margin="14" Spacing="8">

    <Border Classes="card">
      <StackPanel Spacing="6">
        <TextBlock Text="STARTUP" Classes="h"/>
        <CheckBox Content="Start the daemon at login (systemd user service)"
                  IsChecked="{Binding StartDaemonAtLogin, Mode=TwoWay}" IsEnabled="{Binding !DaemonStartupChanging}"/>
        <TextBlock Text="{Binding DaemonStartupNote}" Foreground="#e0a84a" TextWrapping="Wrap"/>
        <CheckBox Content="Start the mixer UI at login"
                  IsChecked="{Binding OpenWindowAtLogin, Mode=TwoWay}"/>
        <CheckBox Content="Close button minimizes to tray instead of quitting"
                  IsChecked="{Binding MinimizeToTray, Mode=TwoWay}"/>
        <CheckBox Content="Start minimized to tray"
                  IsChecked="{Binding StartMinimized, Mode=TwoWay}"/>
        <CheckBox Content="Submixer (per-app channels, mixes, virtual microphones, inserts)"
                  IsEnabled="{Binding !SubmixerChanging}"
                  IsChecked="{Binding Submixer, Mode=TwoWay}"
                  ToolTip.Tip="Off: OpenXLR controls the hardware only and leaves the sound card in its stock PipeWire layout (the UCM profile where one exists). Plugin inserts go with the submixer. Toggling restarts the daemon."/>
        <TextBlock Text="{Binding SubmixerNote}" Foreground="#8b93a7" FontSize="11" TextWrapping="Wrap"
                   Margin="26,0,0,0" IsVisible="{Binding SubmixerNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
      </StackPanel>
    </Border>

    <Border Classes="card">
      <StackPanel Spacing="6">
        <TextBlock Text="SYSTEM DEFAULT DEVICES" Classes="h"/>
        <TextBlock Text="When set, OpenXLR holds these as the system defaults and reverts any outside change, like Wave Link does. Applications that follow the system default will use them."
                   FontSize="11" Foreground="#6b7285" TextWrapping="Wrap"/>

        <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,8,Auto">
          <TextBlock Text="Default output" Classes="h" VerticalAlignment="Center"/>
          <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                    ItemsSource="{Binding OutputChoices}"
                    SelectedItem="{Binding EnforcedOutput, Mode=TwoWay}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:DeviceChoice">
                <TextBlock Text="{Binding Label}"/>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>

          <TextBlock Grid.Row="2" Text="Default input" Classes="h" VerticalAlignment="Center"/>
          <ComboBox Grid.Row="2" Grid.Column="1" HorizontalAlignment="Stretch"
                    ItemsSource="{Binding InputChoices}"
                    SelectedItem="{Binding EnforcedInput, Mode=TwoWay}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:DeviceChoice">
                <TextBlock Text="{Binding Label}"/>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </Grid>

        <TextBlock Text="Tip: enforcing OpenXLR Chat as default input makes voice apps record the Chat mix automatically."
                   FontSize="11" Foreground="#6b7285" TextWrapping="Wrap"/>
      </StackPanel>
    </Border>

    <Border Classes="card">
      <StackPanel Spacing="6">
        <TextBlock Text="UPDATES" Classes="h"/>
        <TextBlock Text="{Binding Updates.Build}" Foreground="#8b93a7" FontSize="11" TextWrapping="Wrap"/>
        <CheckBox Content="Check GitHub for updates when OpenXLR starts" IsChecked="{Binding CheckForUpdates, Mode=TwoWay}"/>
        <TextBlock Text="{Binding Updates.Title}" Foreground="#5ba8f5" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="Check now" Click="OnCheckUpdates" IsEnabled="{Binding !Updates.Busy}"/>
          <Button Content="Version / changes" Click="OnUpdates"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <Border Classes="card">
      <StackPanel Spacing="6">
        <TextBlock Text="SUPPORT" Classes="h"/>
        <Button Content="Restart daemon" Click="OnRestartDaemon" IsEnabled="{Binding !Service.Busy}"
                ToolTip.Tip="Briefly interrupts OpenXLR audio. The UI reconnects automatically."/>
        <TextBlock Text="{Binding Service.Status}" Foreground="#e0a84a" TextWrapping="Wrap"
                   IsVisible="{Binding Service.Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
        <TextBlock Text="Collect diagnostics gathers app and device state, the PipeWire graph, daemon logs and configs into one archive in your home folder, ready to attach to a bug report. Nothing is uploaded."
                   FontSize="11" Foreground="#6b7285" TextWrapping="Wrap"/>
        <Grid ColumnDefinitions="Auto,10,*">
          <Button Content="Collect diagnostics" Padding="14,5" Click="OnCollectDiagnostics"/>
          <TextBlock Grid.Column="2" Name="DiagStatus" FontSize="11" Foreground="#8b93a7"
                     VerticalAlignment="Center" TextWrapping="Wrap"/>
        </Grid>
      </StackPanel>
    </Border>

    <Button Content="Close" HorizontalAlignment="Right" Padding="18,6" Margin="0,2,0,6" Click="OnClose"/>
  </StackPanel>
  </ScrollViewer>
</Window>
